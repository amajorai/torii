{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torii",
  "version": "0.3.1",
  "identifier": "com.amajorai.torii",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bunx vite",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Torii",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Torii",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxNjA4MUU5N0Q2ODg5MjcKUldRbmlXaDk2WUZnY1NuMVpLZ25VS0sxWFVZaTBISjd3VzVweHo0L04zRVlqOUpsUE0zUTlqYWUK",
      "endpoints": [
        "https://github.com/amajorai/torii/releases/latest/download/latest.json"
      ]
    }
  }
}
